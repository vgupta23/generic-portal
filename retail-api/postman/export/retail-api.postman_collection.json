{
  "info": {
    "name": "Retail API (toys & flowers)",
    "description": "Run with the Collection Runner (top to bottom). Prerequisites: Keycloak running and configured, ./scripts/setup-keycloak-api-test.sh executed, retail-api container running on http://localhost:8090.\n\nThe first folder fetches real tokens from Keycloak; the rest call the API with them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "realm",
      "value": "demo"
    },
    {
      "key": "clientId",
      "value": "retail-api-test"
    },
    {
      "key": "password",
      "value": "password"
    }
  ],
  "item": [
    {
      "name": "0. Get tokens from Keycloak",
      "item": [
        {
          "name": "Get tokens - apiuser",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "apiuser"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                },
                {
                  "key": "scope",
                  "value": "openid"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Password grant against Keycloak (dev-only client retail-api-test). Stores the access and ID token for this user as collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Keycloak returned tokens for apiuser', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.a('string');",
                  "  pm.expect(body.id_token).to.be.a('string');",
                  "  pm.collectionVariables.set('access_apiuser', body.access_token);",
                  "  pm.collectionVariables.set('id_apiuser', body.id_token);",
                  "});",
                  "pm.test('Access token carries duns_roles and the retail-ui audience', function () {",
                  "  const claims = JSON.parse(atob(pm.response.json().access_token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "  pm.expect(claims.duns_roles).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(claims.aud).to.include('retail-ui');",
                  "});"
                ]
              }
            }
          ]
        },
