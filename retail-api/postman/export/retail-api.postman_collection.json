        {
          "name": "Access token with tampered signature",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_apiuser}}"
              },
              {
                "key": "X-ID-Token",
                "value": "{{id_apiuser}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/toys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "toys"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const parts = pm.collectionVariables.get('access_apiuser').split('.');",
                  "const sig = parts[2];",
                  "const mid = Math.floor(sig.length / 2);",
                  "parts[2] = sig.slice(0, mid) + (sig[mid] === 'A' ? 'B' : 'A') + sig.slice(mid + 1);  // still valid base64, wrong signature",
                  "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + parts.join('.') });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Body is a JSON access_denied error', function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.error).to.eql('access_denied');",
                  "  pm.expect(b.status).to.eql(401);",
                  "  pm.expect(b.message).to.be.a('string').and.not.empty;",
                  "  pm.expect(b.message).to.include('Invalid signature');",
                  "});"
                ]
              }
            }
          ]
        },
